{
  "name": "dot-connector",
  "version": "0.1.13",
  "description": "A toolkit that lets dot observe and control the same visible terminal window the user works in.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "src/",
    "profiles/",
    "scripts/",
    "test/",
    "README.md",
    "docs/",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    ".agents/plugins/marketplace.json",
    "!src/native-console-prototype.cs",
    "!test/console-prototype.test.mjs",
    "CONTRIBUTING.md",
    "!docs/PROPOSAL-*.md",
    "!docs/*-REVIEW.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "npm run build && npm test && npm run check:release",
    "start": "node src/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "start:plugin": "node src/plugin-server.mjs",
    "smoke:plugin": "node scripts/plugin-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@xterm/xterm": "6.0.0",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dot-connector": "scripts/dot-connector.mjs"
  }
}
